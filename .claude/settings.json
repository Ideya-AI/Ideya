{
  "env": {
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "1500"
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python manage.py check_topic_text *)",
      "Bash(.venv/bin/python manage.py check_links *)",
      "Bash(.venv/bin/python manage.py check_topic_drift *)",
      "Bash(.venv/bin/python manage.py load_universe *)",
      "Bash(.venv/bin/python manage.py token_report *)",
      "Bash(.venv/bin/python manage.py generate_icon *)",
      "Bash(.venv/bin/python manage.py render_screens *)",
      "Bash(.venv/bin/python manage.py render_social *)",
      "Bash(.venv/bin/python manage.py render_poster *)",
      "Bash(.venv/bin/python manage.py mark_ready *)",
      "Bash(python3 .claude/hooks/usage-guard.py *)",
      "Bash(.venv/bin/python -c *)",
      "Bash(.venv/bin/python - *)",
      "Bash(.venv/bin/python manage.py shell -c *)",
      "Bash(DJANGO_DEBUG=true nohup .venv/bin/python manage.py runserver 8641 *)",
      "Bash(echo *)",
      "Bash(date *)",
      "Bash(stat *)",
      "Bash(grep *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(google-chrome --headless=new *)",
      "Bash(curl -s *)",
      "Bash(ss -ltn*)",
      "Bash(mkdir -p research/topics/*)",
      "Bash(touch research/topics/*)",
      "Bash(rm -f research/topics/*)",
      "Bash(rm -rf research/topics/*/renders*)",
      "WebSearch",
      "WebFetch(domain:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/usage-guard.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
