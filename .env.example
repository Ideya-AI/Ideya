# Copy to .env for local dev, or set these as real environment variables in prod.
# Settings reads .env automatically (see infinity/settings.py).

# Turn DEBUG on locally. MUST be false/unset in production.
DJANGO_DEBUG=true

# Required in production (when DEBUG is off). Generate one with:
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Comma-separated hostnames the site serves (required in production).
DJANGO_ALLOWED_HOSTS=ideya1.org,www.ideya1.org,ideya1.com,www.ideya1.com

# Comma-separated origins trusted for CSRF (scheme required).
DJANGO_CSRF_TRUSTED_ORIGINS=https://ideya1.org,https://www.ideya1.org,https://ideya1.com,https://www.ideya1.com

# Public origin baked into print artifacts (poster QR codes), scheme included.
# Set this to the real site before printing posters, or the QR encodes localhost.
PUBLIC_ORIGIN=https://ideya1.org

# Optional overrides (staging / proxy quirks):
# DJANGO_SSL_REDIRECT=false      # disable forced HTTPS redirect
# DJANGO_HSTS_SECONDS=31536000   # HSTS max-age; set 0 to disable while testing
# DJANGO_DB_PATH=/data/db.sqlite3  # SQLite path — a persistent volume in prod

# Gemini image API (Nano Banana) — for research/icons/generate_icons.py
GEMINI_API_KEY=
